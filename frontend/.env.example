# ===============================================
# 💈 BarberFlow Frontend Environment Variables
# ===============================================

# Railway'ga yuklangan Backend API URL manzili
# Masalan: https://barberflow-backend.up.railway.app
VITE_API_URL=http://localhost:5050

# WebSocket manzili (ixtiyoriy, agar ko'rsatilmasa VITE_API_URL dan avtomatik wss:// qilib olinadi)
# Masalan: wss://barberflow-backend.up.railway.app/ws
VITE_WS_URL=ws://localhost:5050/ws
